generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int     @id @default(autoincrement())
  name         String
  email        String  @unique
  password     String
  avatar       String?
  isVerified   Boolean @default(false)
  refreshToken String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LearningTopic {
  id          String           @id @default(uuid())
  name        String
  slug        String           @unique
  description String?
  thumbnail   String?
  category    String
  difficulty  TopicDifficulty?
  status      TopicStatus      @default(DRAFT)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  learningPaths LearningPath[]

  @@index([category])
  @@index([status])
  @@index([name])
}

enum TopicStatus {
  DRAFT
  PROCESSING
  PUBLISHED
  ARCHIVED
}

enum TopicDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

model LearningPath {
  id          String  @id @default(uuid())
  title       String
  description String?

  topicId String
  topic   LearningTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  status LearningPathStatus @default(DRAFT)

  lessons     LearningPathLesson[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  @@index([topicId])
  @@index([status])
}

enum LearningPathStatus {
  DRAFT
  PROCESSING
  PUBLISHED
  ARCHIVED
}

model LearningPathLesson {
  id         String @id @default(uuid())

  learningPathId  String
  learningPath    LearningPath @relation(fields: [learningPathId], references: [id], onDelete: Cascade)

  title       String
  description String?  
  order       Int

  videos      LearningVideo[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([learningPathId, order])
  @@index([learningPathId]) 
}

model LearningVideo {
  id        String @id @default(uuid())

  lessonId  String
  lesson LearningPathLesson@relation(fields: [lessonId], references: [id], onDelete: Cascade)
  
  youtubeVideoId String @unique
  title          String
  description    String?
  thumbnailUrl   String?
  channelName    String?
  channelId      String?

  durationSeconds Int?

  transcriptUrl   String?

  relevanceScore  Float?
  qualityScore    Float?
  difficultyScore Float?
  
  aiSummary      String?

  status         VideoStatus @default(PENDING)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([lessonId])
  @@index([status])
}

enum VideoStatus {
  PENDING
  ANALYZING
  APPROVED
  REJECTED
}